    "ink": "^6.3.0",
    "picocolors": "^1.1.1",
    "react": "^19.0.0",
    "semver": "^7.6.3",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
