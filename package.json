{
  "name": "@dennisrepa/elevate",
  "version": "1.2.0",
  "description": "🪶 Elevate — Interactive Polyglot Terminal Dashboard & Agentic MCP Server for safe dependency updates across monorepos.",
  "type": "module",
  "main": "./dist/cli.js",
